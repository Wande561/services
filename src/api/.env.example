DATABASE_URL="postgresql://postgres:postgres@localhost:5432/doit?schema=public"
FRONTEND_URL="http://localhost:3000"
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
# Defaults to FRONTEND_URL/api/auth/google/callback when empty.
GOOGLE_REDIRECT_URI=""
RESEND_API_KEY=""
MAIL_FROM=""
# Optional Gmail alternative for small deployments. Use an app password, never your Google password.
GMAIL_USER=""
GMAIL_APP_PASSWORD=""
R2_ACCOUNT_ID=""
R2_BUCKET_NAME=""
R2_ACCESS_KEY_ID=""
R2_SECRET_ACCESS_KEY=""
AI_PROVIDER=openai
OPENAI_API_KEY=""
OPENAI_MODEL=""
ANTHROPIC_API_KEY=""
ANTHROPIC_MODEL=""
AI_RATE_LIMIT_MAX=10
AI_RATE_LIMIT_WINDOW_MS=60000
AI_MAX_OUTPUT_TOKENS=600
AI_REQUEST_TIMEOUT_MS=20000
AI_CONVERSATION_HISTORY_TURNS=6
PORT=3001
NODE_ENV=development
# Shared with the external reminder scheduler; never put it in a URL.
CRON_SECRET=""
