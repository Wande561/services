  transient let oneDay = 24 * 60 * 60 * 1_000_000_000;

  system func preupgrade() {

    bountyEntries := Iter.toArray(bounty.entries());
    allocationEntries := Iter.toArray(allocation.entries());
    campaignEntries := Iter.toArray(campaign.entries());

    tierEntries := Iter.toArray(tier.entries());
    campaignTaskEntries := Iter.toArray(campaignTask.entries());
    campaignUserEntries := Iter.toArray(campaignUser.entries());
    socialMediaEntries := Iter.toArray(socialMedia.entries());
    userSocialMediaEntries := Iter.toArray(userSocialMedia.entries());
    bountyPointEntries := Iter.toArray(bountyPoint.entries());
    bountyTransactionEntries := Iter.toArray(bountyTransaction.entries());
  };

  system func postupgrade() {
    migrateToStableHashMaps();
    bounty := TrieMap.fromEntries<BountyId, Types.BountyV1>(bountyEntries.vals(), Text.equal, Text.hash);
    allocation := TrieMap.fromEntries<Text, Types.AllocationV1>(allocationEntries.vals(), Text.equal, Text.hash);
    campaign := TrieMap.fromEntries<Text, Types.CampaignV1>(campaignEntries.vals(), Text.equal, Text.hash);
    tier := TrieMap.fromEntries<Text, Types.TierV1>(tierEntries.vals(), Text.equal, Text.hash);
    campaignTask := TrieMap.fromEntries<Text, Types.CampaignTaskV1>(campaignTaskEntries.vals(), Text.equal, Text.hash);
    campaignUser := TrieMap.fromEntries<Text, Types.CampaignUserV1>(campaignUserEntries.vals(), Text.equal, Text.hash);
    socialMedia := TrieMap.fromEntries<Text, Types.SocialMediaV1>(socialMediaEntries.vals(), Text.equal, Text.hash);
    userSocialMedia := TrieMap.fromEntries<Text, Types.UserSocialMediaV1>(userSocialMediaEntries.vals(), Text.equal, Text.hash);
    bountyPoint := TrieMap.fromEntries<Text, Types.BountyPointV1>(bountyPointEntries.vals(), Text.equal, Text.hash);
    bountyTransaction := TrieMap.fromEntries<Text, Types.BountyTransactionV1>(bountyTransactionEntries.vals(), Text.equal, Text.hash);
    bountyEntries := [];
    allocationEntries := [];
    campaignEntries := [];
    tierEntries := [];
    campaignTaskEntries := [];
    campaignUserEntries := [];
    socialMediaEntries := [];
    userSocialMediaEntries := [];
    bountyPointEntries := [];
    bountyTransactionEntries := [];
  };

  private func migrateToStableHashMaps() {
    for ((key, value) in bounty.entries()) {
      let updatedType : Types.Bounty = {
        id = value.id;
        version = Constants.GLOBAL_STRUCTURES_VERSION;
        name = value.name;
        acCategoryId = value.acCategoryId;
        availableBal = value.availableBal;
        isLive = value.isLive;
        bountyPool = value.bountyPool;
        startDate = value.startDate;
        endDate = value.endDate;
        timeStamp = value.timeStamp;
        createdBy = value.createdBy;
        isDelete = value.isDelete;
      };
      ignore Map.put(bounties_state.bounties, thash, key, updatedType);
    };
    for ((key, value) in allocation.entries()) {
      let updatedType : Types.Allocation = {
        id = value.id;
        version = Constants.GLOBAL_STRUCTURES_VERSION;
        name = value.name;
        amount = value.amount;
        currency = value.currency;
        bountyId = value.bountyId;
        timeStamp = value.timeStamp;
        createdBy = value.createdBy;
        isDelete = value.isDelete;
      };
      ignore Map.put(allocations_state.allocations, thash, key, updatedType);
    };
    for ((key, value) in campaign.entries()) {
      let updatedType : Types.Campaign = {
        id = value.id;
        version = Constants.GLOBAL_STRUCTURES_VERSION;
        name = value.name;
        bountyId = value.bountyId;
        url = value.url;
        campaignType = value.campaignType;
        campaignPic = value.campaignPic;
        totalValue = value.totalValue;
        availBal = value.availBal;
        rules = value.rules;
        notes = value.notes;
        isLive = value.isLive;
        timeStamp = value.timeStamp;
        createdBy = value.createdBy;
        isDelete = value.isDelete;
      };
      ignore Map.put(campaigns_state.campaigns, thash, key, updatedType);
    };
    for ((key, value) in tier.entries()) {
      let updatedType : Types.Tier = {
        id = value.id;
        version = Constants.GLOBAL_STRUCTURES_VERSION;
        name = value.name;
        campaignId = value.campaignId;
        amount = value.amount;
        percent = value.percent;
        followFrom = value.followFrom;
        followTo = value.followTo;
        timeStamp = value.timeStamp;
        createdBy = value.createdBy;
        isDelete = value.isDelete;
      };
      ignore Map.put(tiers_state.tiers, thash, key, updatedType);
    };
    for ((key, value) in campaignTask.entries()) {
      let updatedType : Types.CampaignTask = {
        id = value.id;
        version = Constants.GLOBAL_STRUCTURES_VERSION;
        campaignId = value.campaignId;
        task = value.task;
        allocation = value.allocation;
        timeStamp = value.timeStamp;
        createdBy = value.createdBy;
        isDelete = value.isDelete;
      };
      ignore Map.put(campaignTasks_state.campaignTasks, thash, key, updatedType);
    };
    for ((key, value) in campaignUser.entries()) {
      let updatedType : Types.CampaignUser = {
        id = value.id;
        version = Constants.GLOBAL_STRUCTURES_VERSION;
        campaignId = value.campaignId;
        userId = value.userId;
        campaignTaskId = value.campaignTaskId;
        url = value.url;
        status = value.status;
        isPaid = value.isPaid;
        timeStamp = value.timeStamp;
        createdBy = value.createdBy;
        updatedBy = value.updatedBy;
        isDelete = value.isDelete;
      };
      ignore Map.put(campaignUsers_state.campaignUsers, thash, key, updatedType);
    };
    for ((key, value) in campaign.entries()) {
      let updatedType : Types.Campaign = {
        id = value.id;
        version = Constants.GLOBAL_STRUCTURES_VERSION;
        name = value.name;
        bountyId = value.bountyId;
        url = value.url;
        campaignType = value.campaignType;
        campaignPic = value.campaignPic;
        totalValue = value.totalValue;
        availBal = value.availBal;
        rules = value.rules;
        notes = value.notes;
        isLive = value.isLive;
        timeStamp = value.timeStamp;
        createdBy = value.createdBy;
        isDelete = value.isDelete;
      };
      ignore Map.put(campaigns_state.campaigns, thash, key, updatedType);
    };
    for ((key, value) in socialMedia.entries()) {
      let updatedType : Types.SocialMedia = {
        id = value.id;
        version = Constants.GLOBAL_STRUCTURES_VERSION;
        name = value.name;
        logo = value.logo;
        url = value.url;
        timeStamp = value.timeStamp;
        createdBy = value.createdBy;
        isDelete = value.isDelete;
      };
      ignore Map.put(socialMedias_state.socialMedias, thash, key, updatedType);
    };
    for ((key, value) in userSocialMedia.entries()) {
      let updatedType : Types.UserSocialMedia = {
        id = value.id;
        version = Constants.GLOBAL_STRUCTURES_VERSION;
        userId = value.userId;
        userName = value.userName;
        socialMediaId = value.socialMediaId;
        timeStamp = value.timeStamp;
        createdBy = value.createdBy;
        isDelete = value.isDelete;
      };
      ignore Map.put(userSocialMedias_state.userSocialMedias, thash, key, updatedType);
    };
    for ((key, value) in bountyPoint.entries()) {
      let updatedType : Types.BountyPoint = {
        id = value.id;
        version = Constants.GLOBAL_STRUCTURES_VERSION;
        userId = value.userId;
        campaignId = value.campaignId;
        balance = value.balance;
        totalIn = value.totalIn;
        totalOut = value.totalOut;
        timeStamp = value.timeStamp;
      };
      ignore Map.put(bountyPoints_state.bountyPoints, thash, key, updatedType);
    };
    for ((key, value) in bountyTransaction.entries()) {
      let updatedType : Types.BountyTransaction = {
        id = value.id;
        version = Constants.GLOBAL_STRUCTURES_VERSION;
        senderId = value.senderId;
        receiverId = value.receiverId;
        campaignUserId = value.campaignUserId;
        points = value.points;
        status = value.status;
        timeStamp = value.timeStamp;
      };
      ignore Map.put(bountyTransactions_state.bountyTransactions, thash, key, updatedType);
    };
  };

