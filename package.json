{
  "engines": {
    "node": ">=16.0.0",
    "pnpm": ">=7.0.0"
  },
  "name": "doit",
  "scripts": {
    "dev": "npm run start --prefix src/doit_frontend",
    "dev:api": "npm run start:dev --prefix src/api",
    "build": "npm run build --prefix src/api && npm run build --prefix src/doit_frontend",
    "db:migrate": "npm run db:migrate --prefix src/api",
    "db:status": "npm run db:status --prefix src/api"
  },
  "type": "module",
  "workspaces": [
    "src/doit_frontend"
  ],
  "dependencies": {
    "framer-motion": "^12.23.13",
    "lucide-react": "^0.544.0"
  }
}
