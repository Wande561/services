{
  "engines": {
    "node": ">=16.0.0",
    "pnpm": ">=7.0.0"
  },
  "name": "doit",
  "scripts": {
    "build": "pnpm run build --filter \"*\" --if-present",
    "prebuild": "pnpm run prebuild --filter \"*\" --if-present",
    "pretest": "pnpm run prebuild --filter \"*\" --if-present",
    "start": "pnpm start --filter \"*\" --if-present",
    "test": "pnpm test --filter \"*\" --if-present",
    "dev": "pnpm --filter doit_frontend start",
    "setup": "pnpm --filter doit_frontend setup"
  },
  "type": "module",
  "workspaces": [
    "src/doit_frontend"
  ],
  "dependencies": {
    "framer-motion": "^12.23.13",
    "lucide-react": "^0.544.0"
  }
}